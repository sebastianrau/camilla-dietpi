#!/usr/bin/python3
"""Save/restore DSP runtime settings on a normally read-only config volume."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import shutil
import subprocess
import sys
import tarfile
import time
import uuid

import yaml

STORE = Path('/srv/dsp-store')
RUNTIME = Path('/run/camilladsp')
LOCK = Path('/run/dsp-state.lock')
ENGINE = '/opt/camilla/bin/camilladsp'
SERVICES = ['camillagui.service', 'camilladsp.service']


def run(*args):
    return subprocess.run(args, check=True)


def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()


def check_runtime():
    for top in ('configs', 'coeffs', 'state.yml'):
        if not (RUNTIME / top).exists():
            raise RuntimeError(f'Missing runtime settings: {top}')
    for path in RUNTIME.rglob('*'):
        if path.is_symlink() or not (path.is_file() or path.is_dir()):
            raise RuntimeError(f'Unsupported runtime entry: {path}')
    state = yaml.safe_load((RUNTIME / 'state.yml').read_text())
    if not isinstance(state, dict) or not isinstance(state.get('config_path'), str):
        raise RuntimeError('State file has no valid config_path')
    config = Path(state['config_path']).resolve()
    if not config.is_relative_to((RUNTIME / 'configs').resolve()) or not config.is_file():
        raise RuntimeError('Active YAML must be inside /run/camilladsp/configs')
    run(ENGINE, '-c', str(config))


def sync_directory(directory):
    descriptor = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_pointer(manifest):
    pointer = STORE / 'active.json.tmp'
    with pointer.open('w') as stream:
        json.dump(manifest, stream)
        stream.write('\n')
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(pointer, STORE / 'active.json')
    sync_directory(STORE)


def checked_archive():
    manifest = json.loads((STORE / 'active.json').read_text())
    filename = manifest['file']
    if not isinstance(filename, str) or not re.fullmatch(r'dsp-\d{8}-\d{6}-[0-9a-f]{8}\.tar\.gz', filename):
        raise RuntimeError('Invalid snapshot filename')
    archive = STORE / 'snapshots' / filename
    if digest(archive) != manifest['sha256']:
        raise RuntimeError('Snapshot checksum mismatch')
    return archive


def extract_checked(archive, destination):
    with tarfile.open(archive, 'r:gz') as bundle:
        members = bundle.getmembers()
        for member in members:
            parts = Path(member.name).parts
            if (not parts or member.name.startswith('/') or '..' in parts
                    or parts[0] not in ('configs', 'coeffs', 'state.yml')
                    or (parts[0] == 'state.yml' and len(parts) != 1)
                    or not (member.isfile() or member.isdir())):
                raise RuntimeError(f'Unsafe snapshot entry: {member.name}')
        for member in members:
            target = destination / member.name
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
            else:
                target.parent.mkdir(parents=True, exist_ok=True)
                with bundle.extractfile(member) as source, target.open('xb') as output:
                    shutil.copyfileobj(source, output)


def restore():
    # Do not run this against settings used by a live DSP process.
    archive = checked_archive()
    if RUNTIME.exists() and any(RUNTIME.iterdir()):
        raise RuntimeError('Runtime directory is not empty; stop services and clear it first')
    RUNTIME.mkdir(parents=True, exist_ok=True)
    extract_checked(archive, RUNTIME)
    check_runtime()
    shutil.chown(RUNTIME, user='dsp', group='audio')
    RUNTIME.chmod(0o750)
    for path in RUNTIME.rglob('*'):
        shutil.chown(path, user='dsp', group='audio')
        path.chmod(0o750 if path.is_dir() else 0o640)
    print(f'Restored {archive.name}')


def write_snapshot():
    snapshots = STORE / 'snapshots'
    snapshots.mkdir(exist_ok=True)
    filename = time.strftime('dsp-%Y%m%d-%H%M%S-') + uuid.uuid4().hex[:8] + '.tar.gz'
    destination = snapshots / filename
    temporary = snapshots / (filename + '.tmp')
    pointer = STORE / 'active.json.tmp'
    try:
        with tarfile.open(temporary, 'w:gz') as bundle:
            for name in ('configs', 'coeffs', 'state.yml'):
                bundle.add(RUNTIME / name, arcname=name, recursive=True)
        with temporary.open('rb') as stream:
            os.fsync(stream.fileno())
        os.replace(temporary, destination)
        manifest = {'file': filename, 'sha256': digest(destination)}
        sidecar = snapshots / (filename + '.json')
        with sidecar.open('w') as stream:
            json.dump(manifest, stream)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        sync_directory(snapshots)
        write_pointer(manifest)
        os.sync()
    finally:
        temporary.unlink(missing_ok=True)
        pointer.unlink(missing_ok=True)
    return filename


def save(initial=False):
    stopped = []
    failures = []
    filename = None
    primary = None
    try:
        if not initial:
            for service in SERVICES:
                run('systemctl', 'stop', service)
                stopped.append(service)
        check_runtime()
        run('mount', '-o', 'remount,rw', str(STORE))
        filename = write_snapshot()
    except Exception as error:
        primary = error
    finally:
        os.sync()
        try:
            run('mount', '-o', 'remount,ro', str(STORE))
        except Exception as error:
            failures.append(f'Cannot return config volume to read-only: {error}')
        for service in reversed(stopped):
            try:
                run('systemctl', 'start', service)
            except Exception as error:
                failures.append(f'Cannot restart {service}: {error}')
        if failures:
            if primary is not None:
                failures.insert(0, f'Original save failure: {primary}')
            raise RuntimeError('; '.join(failures)) from primary
    if primary is not None:
        raise primary
    print(f'Saved {filename}. Config volume is read-only. Check audio status.')


def select_snapshot(filename):
    if not re.fullmatch(r'dsp-\d{8}-\d{6}-[0-9a-f]{8}\.tar\.gz', filename):
        raise RuntimeError('Use an exact snapshot filename from the list')
    manifest = json.loads((STORE / 'snapshots' / (filename + '.json')).read_text())
    if manifest.get('file') != filename or digest(STORE / 'snapshots' / filename) != manifest.get('sha256'):
        raise RuntimeError('Snapshot metadata/checksum mismatch')
    try:
        run('mount', '-o', 'remount,rw', str(STORE))
        write_pointer(manifest)
        os.sync()
    finally:
        run('mount', '-o', 'remount,ro', str(STORE))
    print('Snapshot selected for the next boot. Reboot to restore it.')


def main():
    def interrupted(signum, _frame):
        raise RuntimeError(f'Interrupted by signal {signum}; checking save cleanup')
    signal.signal(signal.SIGHUP, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['save', 'restore', 'list', 'select'])
    parser.add_argument('--initial', action='store_true', help='Save before services are installed')
    parser.add_argument('--snapshot', help='Exact filename for select')
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise RuntimeError('Run as root')
    if not STORE.is_mount():
        raise RuntimeError('/srv/dsp-store must be a separate mounted filesystem')
    filesystem = subprocess.check_output(['findmnt', '-n', '-o', 'FSTYPE', '--mountpoint', str(STORE)], text=True).strip()
    if filesystem != 'ext4':
        raise RuntimeError('Settings store must be the real ext4 partition, not an overlay/tmpfs')
    if args.action == 'select':
        if not args.snapshot:
            raise RuntimeError('select requires --snapshot FILENAME')
        for service in SERVICES:
            if subprocess.run(['systemctl', 'is-active', '--quiet', service], check=False).returncode == 0:
                raise RuntimeError('Stop GUI and DSP before selecting a rollback snapshot')
    if args.action == 'save':
        active = [s for s in SERVICES if subprocess.run(
            ['systemctl', 'is-active', '--quiet', s], check=False).returncode == 0]
        if args.initial and active:
            raise RuntimeError('--initial is only for installation with audio services stopped')
        if not args.initial:
            if subprocess.run(['systemctl', 'is-active', '--quiet', 'dsp-settings.service'],
                              check=False).returncode != 0:
                raise RuntimeError('Restore unit is not active. Restore/start the settings service first.')
            if len(active) != len(SERVICES):
                raise RuntimeError('Normal save expects both GUI and DSP services active. Fix/start them first.')
    with LOCK.open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if args.action == 'restore':
            restore()
        elif args.action == 'save':
            save(initial=args.initial)
        elif args.action == 'select':
            select_snapshot(args.snapshot)
        else:
            print((STORE / 'active.json').read_text())
            for archive in sorted((STORE / 'snapshots').glob('*.tar.gz')):
                print(archive.name, archive.stat().st_size)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(f'ERROR: {error}', file=sys.stderr)
        sys.exit(1)
