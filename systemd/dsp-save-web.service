[Unit]
Description=Permanent DSP save button endpoint
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/camilla/bin/dsp-save-web.py
User=root
Restart=on-failure
RestartSec=3
UMask=0077
# Fixed-action helper runs independently of the GUI; saves leave audio services running.

[Install]
WantedBy=multi-user.target
